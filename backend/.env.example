# Copy to .env and fill in. Never commit the real .env.

# App
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Database
DATABASE_URL=postgresql+psycopg://learn:learn@localhost:5432/learnbot

# LLM (used from the agent-loop step onward)
ANTHROPIC_API_KEY=
# Exact model ID. Valid examples (Aug 2026): claude-sonnet-5, claude-opus-5,
# claude-haiku-4-5-20251001. Leave ANTHROPIC_API_KEY blank to use the stub.
ANTHROPIC_MODEL=claude-sonnet-5

# MCP — set CUDA_MCP_URL to enable real, cited CUDA doc retrieval.
# Leave blank to run ungrounded (tutor answers from general knowledge).
CUDA_MCP_URL=
CUDA_MCP_TOOL=           # optional: exact search tool name (else auto-discovered)
CUDA_MCP_API_KEY=        # optional: bearer token for the MCP server
CUDA_MCP_TRANSPORT=http  # "http" (streamable) or "sse"
MCP_QUERY_ARG=query      # the search tool's query argument name
